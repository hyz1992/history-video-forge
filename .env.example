# Runtime provider
# openai means an OpenAI-compatible /chat/completions endpoint.
LLM_PROVIDER=openai

# General generation model.
# GLM-5.1 can be used for topic generation, script writing, and shadow review.
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=glm-5.1

# Strict structured model.
# For glm-5.1, the runtime automatically uses the validated tool-call defaults.
LLM_STRUCTURED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_STRUCTURED_API_KEY=replace-with-your-api-key
LLM_STRUCTURED_MODEL=glm-5.1

# Real model calls need a longer timeout than local/stub runs.
LLM_TIMEOUT_MS=120000

# DeepSeek example. Switch both the general and structured model settings together.
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=replace-with-your-api-key
# LLM_MODEL=deepseek-v4-flash
# LLM_STRUCTURED_BASE_URL=https://api.deepseek.com
# LLM_STRUCTURED_API_KEY=replace-with-your-api-key
# LLM_STRUCTURED_MODEL=deepseek-v4-flash
