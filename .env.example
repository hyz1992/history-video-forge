# Runtime provider
# openai 表示使用 OpenAI-compatible /chat/completions 协议。
LLM_PROVIDER=openai

# 通用生成模型配置。
# GLM-5.1 已通过 topic -> script live harness，可同时用于选题生成与脚本生成。
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=glm-5.1

# 严格结构化输出配置。
# 当前 strict pilot 只接入 topic.selector；GLM-5.1 需使用 tool_call 才能避免 json_object 下的 schema 漂移。
LLM_STRUCTURED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_STRUCTURED_API_KEY=replace-with-your-api-key
LLM_STRUCTURED_MODEL=glm-5.1
LLM_STRUCTURED_STRATEGY=tool_call
LLM_STRUCTURED_THINKING=disabled
LLM_STRUCTURED_TEMPERATURE=0.5
LLM_STRUCTURED_TOP_P=0.9
LLM_STRUCTURED_MAX_TOKENS=2048

# 真实模型运行建议拉长超时；五轮 GLM-5.1 live probe 使用该值。
LLM_TIMEOUT_MS=120000

# DeepSeek 示例。切换 provider 时，同时替换通用模型与 structured 模型配置。
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=replace-with-your-api-key
# LLM_MODEL=deepseek-v4-flash
# LLM_STRUCTURED_BASE_URL=https://api.deepseek.com
# LLM_STRUCTURED_API_KEY=replace-with-your-api-key
# LLM_STRUCTURED_MODEL=deepseek-v4-flash
# LLM_STRUCTURED_STRATEGY=json_object
