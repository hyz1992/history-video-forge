# Runtime provider
LLM_PROVIDER=openai

# # 使用deepseek的模型
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=replace-with-your-api-key
# LLM_MODEL=deepseek-v4-flash
# LLM_STRUCTURED_BASE_URL=https://api.deepseek.com
# LLM_STRUCTURED_API_KEY=replace-with-your-api-key
# LLM_STRUCTURED_MODEL=deepseek-v4-flash

# 使用智谱的模型
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=glm-5.1
LLM_STRUCTURED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_STRUCTURED_API_KEY=replace-with-your-api-key
LLM_STRUCTURED_MODEL=glm-4
LLM_TIMEOUT_MS=45000
