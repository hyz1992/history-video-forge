# =============================================================================
# S2-1 多模型多供应商切换（推荐配置方式）
# 设计文档：docs/plans/2026-07-17-s2-1-multi-provider-model-routing-design.md
# =============================================================================
#
# tier → provider:model 映射（opencode 风格 "<provider>:<model>"）
# - smart：需要 reasoning 深度的任务（writer/planner/selector/reviewer）
# - flash：短结构化输出任务（title/description/cover/asset-prompt-optimizer）
# 未配置 LLM_FLASH_MODEL 时，flash tier 回退到 smart tier（渐进迁移）。
# 未配置 LLM_SMART_MODEL 时，smart tier 回退到下方旧 LLM_MODEL（兼容期）。
#
# provider 注册表（baseUrl + apiKeyEnv 引用）见 backend/providers.json。
# 密钥通过下方 LLM_PROVIDER_*_API_KEY 注入，不写进 providers.json。
# LLM_SMART_MODEL=deepseek:deepseek-v4-pro
# LLM_FLASH_MODEL=zhipu:glm-4
# LLM_PROVIDERS_CONFIG_PATH=/etc/app/providers.json

# S2-1 provider 密钥（与 backend/providers.json 中 apiKeyEnv 引用对应）。
# 示例 providers.json 引用了下面两个变量名；如修改 provider 列表请同步此处。
# LLM_PROVIDER_DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
# LLM_PROVIDER_ZHIPU_API_KEY=replace-with-your-zhipu-api-key

# =============================================================================
# 旧 LLM_* 变量（兼容期保留，S2-1 验收通过后删除）
# 当上方 LLM_SMART_MODEL / LLM_FLASH_MODEL 未配置时，回退使用本组变量。
# =============================================================================

# Runtime provider
# openai means an OpenAI-compatible /chat/completions endpoint.
LLM_PROVIDER=openai

# General generation model.
# GLM-5.1 can be used for topic generation, script writing, and shadow review.
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=glm-5.1

# Strict structured model.
# For glm-5.1, the runtime automatically uses the validated tool-call defaults.
LLM_STRUCTURED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_STRUCTURED_API_KEY=replace-with-your-api-key
LLM_STRUCTURED_MODEL=glm-5.1

# Real model calls need a longer timeout than local/stub runs.
LLM_TIMEOUT_MS=240000

# Shared per-provider HTTP request budget. Set an explicit smaller value before
# starting the backend for an authorized live page acceptance, then restart it.
LLM_REQUEST_BUDGET_MAX_REQUESTS=20

# DashScope assets live-check / real assets providers.
# Keep real values in local .env only; do not commit secrets.
ALIYUN_DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
ALIYUN_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
ALIYUN_DASHSCOPE_TEXT_TO_IMAGE_MODEL=wan2.6-t2i
ALIYUN_DASHSCOPE_TTS_MODEL=qwen3-tts-instruct-flash
# ASR model for subtitle forced-alignment (requires word-level timestamps).
# Only qwen3-asr-flash-filetrans supports async call + enable_words as of 2026-05.
ALIYUN_DASHSCOPE_ASR_MODEL=qwen3-asr-flash-filetrans
# Future video providers should use their own explicit keys, for example:
# ALIYUN_DASHSCOPE_IMAGE_TO_VIDEO_MODEL=wan2.6-i2v

# DeepSeek example. Switch both the general and structured model settings together.
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=replace-with-your-api-key
# LLM_MODEL=deepseek-v4-flash
# LLM_STRUCTURED_BASE_URL=https://api.deepseek.com
# LLM_STRUCTURED_API_KEY=replace-with-your-api-key
# LLM_STRUCTURED_MODEL=deepseek-v4-flash

# 部署域名，发布包中视频/封面引用地址
PUBLIC_BASE_URL=http://localhost:3000

# 服务器配置
SERVER_PORT=3000
SERVER_HOST=127.0.0.1
ALLOW_UNAUTHENTICATED_REMOTE=false

# V2 Prisma 主数据库与认证上线前的显式项目 owner。
DATABASE_URL=file:./storage/history-video-forge.db
LOCAL_PROJECT_OWNER_ID=local-migration-owner

# 生产模式前端静态资源目录（单端口部署）
# 执行 frontend build 后自动从该目录托管前端资源
# PUBLIC_DIR=frontend/dist

# 比赛演示模式：禁用图片/视频 API 调用，防止 API 成本消耗
# 设置为 true 后，用户只能浏览已有示例项目，不能生成图片和视频
# DEMO_MODE=true

# 受保护项目 ID（逗号分隔）：比赛模式下不允许删除的项目
# PROTECTED_PROJECT_IDS=052a0c19-8723-4d91-8d27-89789a54c5e4
