{
  "name": "story-video-forge2",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@langchain/core": "1.1.40",
    "@langchain/langgraph": "1.2.9"
  },
  "workspaces": [
    "backend",
    "frontend",
    "shared",
    "renderer"
  ],
  "scripts": {
    "dev:backend": "node --import tsx backend/src/server.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "test": "vitest run",
    "test:harness:topic-script-regression": "vitest run tests/harness/topic-script-regression.test.ts",
    "harness:script-semantic-fixtures": "tsx harness/scripts/runtime/script-semantic-reviewer-fixtures.ts",
    "harness:asset-planning-five-round-quality-check": "tsx harness/scripts/runtime/asset-planning-five-round-quality-check.ts",
    "harness:storyboard-five-round-quality-check": "tsx harness/scripts/runtime/storyboard-five-round-quality-check.ts",
    "harness:topic-script-five-round-quality-check": "tsx harness/scripts/runtime/topic-script-five-round-quality-check.ts",
    "harness:topic-script-live-check": "tsx harness/scripts/runtime/topic-script-live-check.ts",
    "harness:assets-dashscope-live-check": "tsx harness/scripts/runtime/assets-dashscope-live-check.ts",
    "harness:assets-dashscope-tts-live-check": "tsx harness/scripts/runtime/assets-dashscope-tts-live-check.ts",
    "harness:assets-dashscope-voice-live-check": "tsx harness/scripts/runtime/assets-dashscope-voice-live-check.ts",
    "harness:assets-dashscope-image-to-video-live-check": "tsx harness/scripts/runtime/assets-dashscope-image-to-video-live-check.ts",
    "harness:compose-runtime-smoke": "tsx harness/scripts/runtime/compose-runtime-smoke.ts",
    "harness:render-runtime-smoke": "tsx harness/scripts/runtime/render-runtime-smoke.ts",
    "render:remotion:smoke": "tsx harness/scripts/runtime/render-runtime-smoke.ts --adapter=remotion",
    "harness:ui-acceptance:smoke": "tsx harness/scripts/ui-acceptance/ui-acceptance-smoke.ts",
    "harness:ui-acceptance:full": "tsx harness/scripts/ui-acceptance/ui-acceptance-full.ts",
    "harness:ui-acceptance:report": "tsx harness/scripts/ui-acceptance/ui-acceptance-report.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/compiler-sfc": "^3.5.17",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  }
}
