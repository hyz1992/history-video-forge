{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Backend Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--import", "tsx"],
      "args": ["${workspaceFolder}/backend/src/server.ts"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Run Frontend Dev Server",
      "type": "pwa-node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:frontend"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug Frontend (Chrome)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5173/topic",
      "webRoot": "${workspaceFolder}/frontend",
      "breakOnLoad": true,
      "breakOnLoadStrategy": "instrument",
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Debug Frontend Only",
      "configurations": ["Run Frontend Dev Server", "Debug Frontend (Chrome)"],
      "stopAll": true
    },
    {
      "name": "Debug Full Stack",
      "configurations": [
        "Debug Backend Server",
        "Run Frontend Dev Server",
        "Debug Frontend (Chrome)"
      ],
      "stopAll": true
    }
  ]
}
