generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id                      String   @id @default(cuid())
  name                    String
  status                  String   @default("topic_pending")
  active_topic_package_id String?
  active_script_record_id String?
  active_storyboard_record_id String?
  active_asset_plan_record_id String?
  active_asset_manifest_record_id String?
  active_compose_record_id String?
  active_render_job_record_id String?
  latest_asset_plan_run_trace_json Json?
  latest_assets_run_trace_json Json?
  latest_compose_run_trace_json Json?
  latest_render_run_trace_json Json?
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  topic_packages TopicPackage[]
  script_records ScriptRecord[]
  storyboard_records StoryboardRecord[]
  asset_plan_records AssetPlanRecord[]
  asset_manifest_records AssetManifestRecord[]
  compose_records ComposeRecord[]
  render_job_records RenderJobRecord[]
}

model EventRegistryEntry {
  id                 String   @id @default(cuid())
  canonical_name     String   @unique
  aliases_json       Json
  source_type        String
  is_provisional     Boolean  @default(false)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  topic_packages                  TopicPackage[]
  recommendation_candidate_cache  RecommendationCandidateCache[]
}

model TopicPackage {
  id                          String   @id @default(cuid())
  project_id                  String
  event_registry_entry_id     String?
  title                       String
  selected_angle              String
  family_label                String
  scope_label                 String
  core_conflict               String
  strong_scene                String
  stakes                      String?
  packaging_seed              String
  canonical_quotes_json       Json
  duration_band_json          Json
  narrative_tension_map_json  Json
  must_include_beats_json     Json
  forbidden_expansions_json   Json
  risk_hints_json             Json
  source_anchor_refs_json     Json
  created_at                  DateTime @default(now())

  project              Project             @relation(fields: [project_id], references: [id])
  event_registry_entry EventRegistryEntry? @relation(fields: [event_registry_entry_id], references: [id])
  script_records       ScriptRecord[]
  storyboard_records   StoryboardRecord[]
  asset_plan_records   AssetPlanRecord[]
  asset_manifest_records AssetManifestRecord[]
}

model RecommendationCandidateCache {
  id                           String   @id @default(cuid())
  project_id                   String?
  event_registry_entry_id      String?
  fingerprint                  String   @unique
  one_line_angle               String
  family_label                 String
  scope_label                  String
  viral_rubric_json            Json
  estimated_duration_band_json Json
  strong_scene                 String
  core_conflict                String
  must_cover_preview_json      Json
  created_at                   DateTime @default(now())

  event_registry_entry EventRegistryEntry? @relation(fields: [event_registry_entry_id], references: [id])
}

model ScriptRecord {
  id                          String   @id @default(cuid())
  project_id                  String
  topic_package_id            String
  script_text                 String
  opening_span                String
  ending_span                 String
  estimated_duration_sec      Int
  beat_trace_json             Json
  quote_trace_json            Json
  review_status               String
  validation_result_json      Json?
  semantic_review_result_json Json?
  execution_state_json        Json?
  created_at                  DateTime @default(now())

  project       Project      @relation(fields: [project_id], references: [id])
  topic_package TopicPackage @relation(fields: [topic_package_id], references: [id])
  storyboard_records StoryboardRecord[]
  asset_plan_records AssetPlanRecord[]
  asset_manifest_records AssetManifestRecord[]
}

model StoryboardRecord {
  id                       String   @id @default(cuid())
  project_id               String
  topic_package_id         String
  script_record_id         String
  plan_json                Json
  validation_result_json   Json
  execution_state_json     Json?
  graph_trace_summary_json Json?
  runtime_diagnostics_json Json?
  created_at               DateTime @default(now())

  project       Project      @relation(fields: [project_id], references: [id])
  topic_package TopicPackage @relation(fields: [topic_package_id], references: [id])
  script_record ScriptRecord @relation(fields: [script_record_id], references: [id])
  asset_plan_records AssetPlanRecord[]
  asset_manifest_records AssetManifestRecord[]
}

model AssetPlanRecord {
  id                       String   @id @default(cuid())
  project_id               String
  topic_package_id         String
  script_record_id         String
  storyboard_record_id     String
  plan_json                Json
  validation_result_json   Json
  execution_state_json     Json
  graph_trace_summary_json Json?
  runtime_diagnostics_json Json?
  created_at               DateTime @default(now())

  project           Project          @relation(fields: [project_id], references: [id])
  topic_package     TopicPackage     @relation(fields: [topic_package_id], references: [id])
  script_record     ScriptRecord     @relation(fields: [script_record_id], references: [id])
  storyboard_record StoryboardRecord @relation(fields: [storyboard_record_id], references: [id])
}

model AssetManifestRecord {
  id                       String   @id @default(cuid())
  project_id               String
  topic_package_id         String
  script_record_id         String
  storyboard_record_id     String
  asset_plan_record_id     String
  manifest_json            Json
  validation_result_json   Json
  execution_state_json     Json?
  graph_trace_summary_json Json?
  runtime_diagnostics_json Json?
  created_at               DateTime @default(now())

  project           Project          @relation(fields: [project_id], references: [id])
  topic_package     TopicPackage     @relation(fields: [topic_package_id], references: [id])
  script_record     ScriptRecord     @relation(fields: [script_record_id], references: [id])
  storyboard_record StoryboardRecord @relation(fields: [storyboard_record_id], references: [id])
  compose_records   ComposeRecord[]
  render_job_records RenderJobRecord[]
}

model ComposeRecord {
  id                       String   @id @default(cuid())
  project_id               String
  asset_manifest_record_id String
  timeline_json            Json
  validation_result_json   Json
  execution_state_json     Json?
  graph_trace_summary_json Json?
  runtime_diagnostics_json Json?
  created_at               DateTime @default(now())

  project               Project             @relation(fields: [project_id], references: [id])
  asset_manifest_record AssetManifestRecord @relation(fields: [asset_manifest_record_id], references: [id])
  render_job_records    RenderJobRecord[]
}

model RenderJobRecord {
  id                       String   @id @default(cuid())
  project_id               String
  compose_record_id        String
  asset_manifest_record_id String
  status                   String
  profile_json             Json
  output_artifact_json     Json?
  validation_result_json   Json
  execution_state_json     Json?
  graph_trace_summary_json Json?
  runtime_diagnostics_json Json?
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  project               Project             @relation(fields: [project_id], references: [id])
  compose_record        ComposeRecord       @relation(fields: [compose_record_id], references: [id])
  asset_manifest_record AssetManifestRecord @relation(fields: [asset_manifest_record_id], references: [id])
}

model AssetProviderJobRecord {
  id                       String   @id @default(cuid())
  asset_manifest_record_id String
  asset_run_id             String
  execution_id             String
  task_id                  String
  provider_type            String
  provider_name            String
  provider_job_id          String?
  status                   String
  attempt_count            Int
  raw_request_json         Json?
  raw_response_json        Json?
  error_code               String?
  error_message            String?
  submitted_at             DateTime?
  last_polled_at           DateTime?
  completed_at             DateTime?
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt
}
