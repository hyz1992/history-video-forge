generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                 String     @id @default(uuid())
  username           String     @unique
  displayName        String
  passwordHash       String
  role               String     @default("USER")
  status             String     @default("ACTIVE")
  mustChangePassword Boolean    @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  sessions           Session[]
  projects           Project[]  @relation("ProjectOwner")
  createdProjects    Project[]  @relation("ProjectCreatedBy")
  auditLogs          AuditLog[] @relation("AuditActor")
  eventLibraryEntries EventLibraryEntry[] @relation("EventLibraryEntryOwner")
  eventLibraryDrafts  EventLibraryDraft[]  @relation("EventLibraryDraftOwner")
  generationPreference UserGenerationPreference?

  @@index([role, status])
}

model Session {
  id            String    @id @default(uuid())
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  lastSeenAt    DateTime?
  userAgentHash String?
  ipPrefix      String?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Project {
  id                           String                         @id @default(uuid())
  ownerId                      String
  createdById                  String
  name                         String
  status                       String                         @default("topic_pending")
  storageKey                   String                         @unique
  storageDisplayName           String
  storageRenameLocked          Boolean                        @default(false)
  archivedAt                   DateTime?
  activeTopicPackageId         String?
  activeScriptRecordId         String?
  activeStoryboardRecordId     String?
  activeAssetPlanRecordId      String?
  activeAssetManifestRecordId  String?
  activeComposeRecordId        String?
  activeRenderJobRecordId      String?
  activePublishPackageRecordId String?
  latestTopicRunTraceJson      Json?
  latestScriptRunTraceJson     Json?
  latestStoryboardRunTraceJson Json?
  latestAssetPlanRunTraceJson  Json?
  latestAssetsRunTraceJson     Json?
  latestComposeRunTraceJson    Json?
  latestRenderRunTraceJson     Json?
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  owner                        User                           @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy                    User                           @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  activeTopicPackage           TopicPackage?                  @relation("ActiveTopicPackage", fields: [activeTopicPackageId], references: [id], onDelete: Restrict)
  activeScriptRecord           ScriptRecord?                  @relation("ActiveScriptRecord", fields: [activeScriptRecordId], references: [id], onDelete: Restrict)
  activeStoryboardRecord       StoryboardRecord?              @relation("ActiveStoryboardRecord", fields: [activeStoryboardRecordId], references: [id], onDelete: Restrict)
  activeAssetPlanRecord        AssetPlanRecord?               @relation("ActiveAssetPlanRecord", fields: [activeAssetPlanRecordId], references: [id], onDelete: Restrict)
  activeAssetManifestRecord    AssetManifestRecord?           @relation("ActiveAssetManifestRecord", fields: [activeAssetManifestRecordId], references: [id], onDelete: Restrict)
  activeComposeRecord          ComposeRecord?                 @relation("ActiveComposeRecord", fields: [activeComposeRecordId], references: [id], onDelete: Restrict)
  activeRenderJobRecord        RenderJobRecord?               @relation("ActiveRenderJobRecord", fields: [activeRenderJobRecordId], references: [id], onDelete: Restrict)
  activePublishPackageRecord   PublishPackageRecord?          @relation("ActivePublishPackageRecord", fields: [activePublishPackageRecordId], references: [id], onDelete: Restrict)
  topicPackages                TopicPackage[]                 @relation("ProjectTopicPackages")
  candidateCache               RecommendationCandidateCache[]
  scriptRecords                ScriptRecord[]                 @relation("ProjectScriptRecords")
  storyboardRecords            StoryboardRecord[]             @relation("ProjectStoryboardRecords")
  assetPlanRecords             AssetPlanRecord[]              @relation("ProjectAssetPlanRecords")
  assetManifestRecords         AssetManifestRecord[]          @relation("ProjectAssetManifestRecords")
  composeRecords               ComposeRecord[]                @relation("ProjectComposeRecords")
  renderJobRecords             RenderJobRecord[]              @relation("ProjectRenderJobRecords")
  publishPackageRecords        PublishPackageRecord[]         @relation("ProjectPublishPackageRecords")
  recommendationRounds         RecommendationRound[]
  auditLogs                    AuditLog[]
  eventLibraryDrafts           EventLibraryDraft[]
  generationConfiguration      ProjectGenerationConfiguration?
  storyboardSegmentOverrides   StoryboardSegmentOverride[]
  generationCostQuotes         GenerationCostQuote[]
  runConfigurationSnapshots    RunConfigurationSnapshot[]
  generationRuns               GenerationRun[]

  @@index([ownerId, updatedAt])
  @@index([createdById, createdAt])
  @@index([status, archivedAt])
}

model EventRegistryEntry {
  id                        String                         @id @default(uuid())
  canonicalName             String                         @unique
  aliasesJson               Json
  canonicalQuotesJson       Json
  canonicalQuoteIntentsJson Json
  sourceType                String
  isProvisional             Boolean                        @default(false)
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt
  topicPackages             TopicPackage[]
  candidateCache            RecommendationCandidateCache[]
  recommendationExposures   RecommendationExposure[]
  eventLibraryEntries       EventLibraryEntry[]
}

model EventLibraryEntry {
  id                   String             @id @default(uuid())
  eventRegistryEntryId String
  canonicalTitle       String
  summary              String
  dynasty              String?
  era                  String?
  characterTagsJson    Json
  eventTypeTagsJson    Json
  conflictTypeTagsJson Json
  themeMotifsJson      Json
  timeRangeJson        Json?
  locationTagsJson     Json
  relationshipTagsJson Json
  sourceAnchorRefsJson Json
  credibilityLevel     String             @default("medium")
  disputeNotes         String?
  visibility           String             @default("public")
  status               String             @default("draft")
  ownerId              String?
  originKind           String             @default("builtin")
  originRefJson        Json?
  libraryFingerprint   String             @unique
  filePath             String?
  fileContentHash      String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  eventRegistryEntry   EventRegistryEntry @relation(fields: [eventRegistryEntryId], references: [id], onDelete: Restrict)
  owner                User?              @relation("EventLibraryEntryOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  angles               EventLibraryAngle[]
  draftsMerged         EventLibraryDraft[] @relation("EventLibraryDraftMerge")

  @@index([status, visibility])
  @@index([dynasty])
  @@index([status, ownerId])
  @@index([originKind, status])
}

model EventLibraryAngle {
  id                  String            @id @default(uuid())
  eventLibraryEntryId String
  angleLabel          String
  familyLabel         String
  scopeLabel          String            @default("standard")
  angleFingerprint    String
  riskHintsJson       Json
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  eventLibraryEntry   EventLibraryEntry @relation(fields: [eventLibraryEntryId], references: [id], onDelete: Cascade)

  @@unique([eventLibraryEntryId, angleFingerprint])
}

model EventLibraryDraft {
  id                     String             @id @default(uuid())
  draftKind              String
  projectId              String
  candidateFingerprint   String?
  eventRegistryEntryId   String?
  proposedTitle          String
  proposedSummary        String
  proposedAnglesJson     Json
  proposedTagsJson       Json
  rawCustomDigest        String?
  customRefinedEventJson Json?
  ownerId                String
  status                 String             @default("draft")
  reviewerId             String?
  reviewedAt             DateTime?
  reviewNotes            String?
  mergedEntryId          String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  project                Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  owner                  User               @relation("EventLibraryDraftOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  mergedEntry            EventLibraryEntry? @relation("EventLibraryDraftMerge", fields: [mergedEntryId], references: [id], onDelete: SetNull)

  @@index([status, ownerId])
  @@index([projectId])
  @@index([draftKind, status])
}

model TopicPackage {
  id                        String                 @id @default(uuid())
  projectId                 String
  eventRegistryEntryId      String?
  title                     String
  selectedAngle             String
  familyLabel               String
  scopeLabel                String
  coreConflict              String
  strongScene               String
  stakes                    String?
  packagingSeed             String
  canonicalQuotesJson       Json
  canonicalQuoteIntentsJson Json
  durationBandJson          Json
  narrativeTensionMapJson   Json
  mustIncludeBeatsJson      Json
  forbiddenExpansionsJson   Json
  riskHintsJson             Json
  sourceAnchorRefsJson      Json
  ambiguityNotesJson        Json
  sourceMode                String               @default("recommended")
  sourceRefJson             Json?
  createdAt                 DateTime               @default(now())
  project                   Project                @relation("ProjectTopicPackages", fields: [projectId], references: [id], onDelete: Restrict)
  eventRegistryEntry        EventRegistryEntry?    @relation(fields: [eventRegistryEntryId], references: [id], onDelete: Restrict)
  activeForProjects         Project[]              @relation("ActiveTopicPackage")
  scriptRecords             ScriptRecord[]
  storyboardRecords         StoryboardRecord[]
  assetPlanRecords          AssetPlanRecord[]
  assetManifestRecords      AssetManifestRecord[]
  publishPackageRecords     PublishPackageRecord[]

  @@index([projectId, createdAt])
  @@index([eventRegistryEntryId])
}

model RecommendationCandidateCache {
  id                        String              @id @default(uuid())
  projectId                 String?
  eventRegistryEntryId      String?
  eventIdentity             String?
  fingerprint               String
  filterFingerprint         String?
  oneLineAngle              String
  familyLabel               String
  scopeLabel                String
  viralRubricJson           Json
  estimatedDurationBandJson Json
  strongScene               String
  coreConflict              String
  mustCoverPreviewJson      Json
  sourceHint                String
  recentUsageHint           String
  whyThisNow                String
  riskHintsJson             Json
  createdAt                 DateTime            @default(now())
  project                   Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  eventRegistryEntry        EventRegistryEntry? @relation(fields: [eventRegistryEntryId], references: [id], onDelete: Restrict)

  @@unique([projectId, fingerprint])
  @@index([projectId, filterFingerprint, createdAt])
  @@index([projectId, eventIdentity, createdAt])
  @@index([eventRegistryEntryId])
}

model ScriptRecord {
  id                       String                 @id @default(uuid())
  projectId                String
  topicPackageId           String
  scriptText               String
  openingSpan              String
  endingSpan               String
  estimatedDurationSec     Int
  beatTraceJson            Json
  quoteTraceJson           Json
  reviewStatus             String
  validationResultJson     Json?
  semanticReviewResultJson Json?
  executionStateJson       Json?
  graphTraceSummaryJson    Json?
  runtimeDiagnosticsJson   Json?
  createdAt                DateTime               @default(now())
  project                  Project                @relation("ProjectScriptRecords", fields: [projectId], references: [id], onDelete: Restrict)
  topicPackage             TopicPackage           @relation(fields: [topicPackageId], references: [id], onDelete: Restrict)
  activeForProjects        Project[]              @relation("ActiveScriptRecord")
  storyboardRecords        StoryboardRecord[]
  assetPlanRecords         AssetPlanRecord[]
  assetManifestRecords     AssetManifestRecord[]
  publishPackageRecords    PublishPackageRecord[]

  @@index([projectId, createdAt])
  @@index([topicPackageId])
}

model StoryboardRecord {
  id                     String                 @id @default(uuid())
  projectId              String
  topicPackageId         String
  scriptRecordId         String
  planJson               Json
  validationResultJson   Json
  executionStateJson     Json?
  graphTraceSummaryJson  Json?
  runtimeDiagnosticsJson Json?
  createdAt              DateTime               @default(now())
  project                Project                @relation("ProjectStoryboardRecords", fields: [projectId], references: [id], onDelete: Restrict)
  topicPackage           TopicPackage           @relation(fields: [topicPackageId], references: [id], onDelete: Restrict)
  scriptRecord           ScriptRecord           @relation(fields: [scriptRecordId], references: [id], onDelete: Restrict)
  activeForProjects      Project[]              @relation("ActiveStoryboardRecord")
  assetPlanRecords       AssetPlanRecord[]
  assetManifestRecords   AssetManifestRecord[]
  publishPackageRecords  PublishPackageRecord[]
  segmentOverrides       StoryboardSegmentOverride[]

  @@index([projectId, createdAt])
  @@index([topicPackageId])
  @@index([scriptRecordId])
}

model AssetPlanRecord {
  id                     String                @id @default(uuid())
  projectId              String
  topicPackageId         String
  scriptRecordId         String
  storyboardRecordId     String
  planJson               Json
  validationResultJson   Json
  executionStateJson     Json
  graphTraceSummaryJson  Json?
  runtimeDiagnosticsJson Json?
  createdAt              DateTime              @default(now())
  project                Project               @relation("ProjectAssetPlanRecords", fields: [projectId], references: [id], onDelete: Restrict)
  topicPackage           TopicPackage          @relation(fields: [topicPackageId], references: [id], onDelete: Restrict)
  scriptRecord           ScriptRecord          @relation(fields: [scriptRecordId], references: [id], onDelete: Restrict)
  storyboardRecord       StoryboardRecord      @relation(fields: [storyboardRecordId], references: [id], onDelete: Restrict)
  activeForProjects      Project[]             @relation("ActiveAssetPlanRecord")
  assetManifestRecords   AssetManifestRecord[]

  @@index([projectId, createdAt])
  @@index([topicPackageId])
  @@index([scriptRecordId])
  @@index([storyboardRecordId])
}

model AssetManifestRecord {
  id                     String                   @id @default(uuid())
  projectId              String
  revision               Int                      @default(1)
  topicPackageId         String
  scriptRecordId         String
  storyboardRecordId     String
  assetPlanRecordId      String
  manifestJson           Json
  validationResultJson   Json
  executionStateJson     Json?
  graphTraceSummaryJson  Json?
  runtimeDiagnosticsJson Json?
  createdAt              DateTime                 @default(now())
  project                Project                  @relation("ProjectAssetManifestRecords", fields: [projectId], references: [id], onDelete: Restrict)
  topicPackage           TopicPackage             @relation(fields: [topicPackageId], references: [id], onDelete: Restrict)
  scriptRecord           ScriptRecord             @relation(fields: [scriptRecordId], references: [id], onDelete: Restrict)
  storyboardRecord       StoryboardRecord         @relation(fields: [storyboardRecordId], references: [id], onDelete: Restrict)
  assetPlanRecord        AssetPlanRecord          @relation(fields: [assetPlanRecordId], references: [id], onDelete: Restrict)
  activeForProjects      Project[]                @relation("ActiveAssetManifestRecord")
  composeRecords         ComposeRecord[]
  renderJobRecords       RenderJobRecord[]
  publishPackageRecords  PublishPackageRecord[]
  providerJobs           AssetProviderJobRecord[]

  @@index([projectId, createdAt])
  @@index([topicPackageId])
  @@index([scriptRecordId])
  @@index([storyboardRecordId])
  @@index([assetPlanRecordId])
}

model ComposeRecord {
  id                     String              @id @default(uuid())
  projectId              String
  assetManifestRecordId  String
  timelineJson           Json
  validationResultJson   Json
  executionStateJson     Json?
  graphTraceSummaryJson  Json?
  runtimeDiagnosticsJson Json?
  createdAt              DateTime            @default(now())
  project                Project             @relation("ProjectComposeRecords", fields: [projectId], references: [id], onDelete: Restrict)
  assetManifestRecord    AssetManifestRecord @relation(fields: [assetManifestRecordId], references: [id], onDelete: Restrict)
  activeForProjects      Project[]           @relation("ActiveComposeRecord")
  renderJobRecords       RenderJobRecord[]

  @@index([projectId, createdAt])
  @@index([assetManifestRecordId])
}

model RenderJobRecord {
  id                     String                 @id @default(uuid())
  projectId              String
  composeRecordId        String
  assetManifestRecordId  String
  status                 String
  profileJson            Json
  outputArtifactJson     Json?
  validationResultJson   Json
  executionStateJson     Json?
  graphTraceSummaryJson  Json?
  runtimeDiagnosticsJson Json?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  project                Project                @relation("ProjectRenderJobRecords", fields: [projectId], references: [id], onDelete: Restrict)
  composeRecord          ComposeRecord          @relation(fields: [composeRecordId], references: [id], onDelete: Restrict)
  assetManifestRecord    AssetManifestRecord    @relation(fields: [assetManifestRecordId], references: [id], onDelete: Restrict)
  activeForProjects      Project[]              @relation("ActiveRenderJobRecord")
  publishPackageRecords  PublishPackageRecord[]

  @@index([projectId, createdAt])
  @@index([composeRecordId])
  @@index([assetManifestRecordId])
}

model PublishPackageRecord {
  id                    String              @id @default(uuid())
  projectId             String
  renderJobRecordId     String
  topicPackageId        String
  scriptRecordId        String
  storyboardRecordId    String
  assetManifestRecordId String
  packageJson           Json
  validationResultJson  Json?
  executionStateJson    Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  project               Project             @relation("ProjectPublishPackageRecords", fields: [projectId], references: [id], onDelete: Restrict)
  renderJobRecord       RenderJobRecord     @relation(fields: [renderJobRecordId], references: [id], onDelete: Restrict)
  topicPackage          TopicPackage        @relation(fields: [topicPackageId], references: [id], onDelete: Restrict)
  scriptRecord          ScriptRecord        @relation(fields: [scriptRecordId], references: [id], onDelete: Restrict)
  storyboardRecord      StoryboardRecord    @relation(fields: [storyboardRecordId], references: [id], onDelete: Restrict)
  assetManifestRecord   AssetManifestRecord @relation(fields: [assetManifestRecordId], references: [id], onDelete: Restrict)
  activeForProjects     Project[]           @relation("ActivePublishPackageRecord")

  @@index([projectId, createdAt])
  @@index([renderJobRecordId])
}

model AssetProviderJobRecord {
  id                    String              @id @default(uuid())
  assetManifestRecordId String
  assetRunId            String
  executionId           String
  taskId                String
  providerType          String
  providerName          String
  providerJobId         String?
  status                String
  attemptCount          Int                 @default(0)
  // S2-2A 外部 provider call-intent 防重合同（P1 整改）：
  // attemptIndex 是冻结合同的 0-based attempt（与 UsageCostRecord.attemptIndex 一致），
  // 区别于运行态 1-based attemptCount（provider 重试计数）。外部提交前写库，靠
  // (generationRunId, providerRequestKey, attemptIndex) 唯一约束阻止并发 dispatcher
  // 重复计费。旧行三者可空（partial index 不约束）；身份三元组创建后不可变。
  attemptIndex          Int?
  generationRunId       String?
  providerRequestKey    String?
  rawRequestJson        Json?
  rawResponseJson       Json?
  errorCode             String?
  errorMessage          String?
  submittedAt           DateTime?
  lastPolledAt          DateTime?
  completedAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  assetManifestRecord   AssetManifestRecord @relation(fields: [assetManifestRecordId], references: [id], onDelete: Restrict)
  generationRun         GenerationRun?      @relation(fields: [generationRunId], references: [id], onDelete: Restrict)
  usageCostRecords      UsageCostRecord[]

  @@unique([assetRunId, executionId, taskId, attemptCount])
  @@index([assetManifestRecordId, status])
  @@index([providerName, providerJobId])
  @@index([generationRunId])
}

model RecommendationRound {
  id                String                   @id @default(uuid())
  projectId         String
  roundIndex        Int
  filterFingerprint String?
  filterJson        Json?
  createdAt         DateTime                 @default(now())
  project           Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  exposures         RecommendationExposure[]

  @@unique([projectId, roundIndex])
  @@index([projectId, filterFingerprint, createdAt])
  @@index([projectId, createdAt])
}

model RecommendationExposure {
  id                   String              @id @default(uuid())
  roundId              String
  eventRegistryEntryId String?
  eventIdentity        String?
  fingerprint          String
  filterFingerprint    String?
  title                String?
  selectedAt           DateTime            @default(now())
  round                RecommendationRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  eventRegistryEntry   EventRegistryEntry? @relation(fields: [eventRegistryEntryId], references: [id], onDelete: Restrict)

  @@unique([roundId, fingerprint])
  @@index([filterFingerprint, selectedAt])
  @@index([eventIdentity, selectedAt])
  @@index([eventRegistryEntryId])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?
  projectId    String?
  action       String
  targetType   String
  targetId     String?
  metadataJson Json?
  createdAt    DateTime @default(now())
  actor        User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([projectId, createdAt])
  @@index([targetType, targetId])
}

model DataMigrationRun {
  id            String    @id @default(uuid())
  sourceSha256  String    @unique
  sourceVersion String
  status        String
  reportJson    Json
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, startedAt])
}

model DatabaseActivation {
  id                String   @id
  mode              String
  schemaVersion     String
  migrationName     String
  migrationChecksum String
  sourceSha256      String?
  activatedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// --- S2-2A 生成配置与费用治理（详细设计第 4 节） -------------------------

/// 用户默认生成偏好（每个用户一行）。S2-2A 只允许修改 video/budget。
model UserGenerationPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  schemaVersion      String
  revision           Int      @default(1)
  configurationJson  Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// 项目冻结的生成配置（每个项目一行）。项目创建时从当时用户默认复制。
model ProjectGenerationConfiguration {
  id                            String   @id @default(uuid())
  projectId                     String   @unique
  schemaVersion                 String
  revision                      Int      @default(1)
  sourceUserPreferenceRevision  Int?
  configurationJson             Json
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  project                       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// 服务端受控 provider/model 目录。用户可见可选模型、启用状态和价格的运行真相源。
/// 每个 capability 恰好一个 active+isDefault=true 项（resolver auto 解析硬合同）。
model ProviderModelCatalog {
  id                          String   @id
  capability                  String
  providerKey                 String
  modelId                     String
  modelVersion                String?
  displayName                 String
  qualityTier                 String?
  speedTier                   String?
  parameterCapabilitiesJson   Json
  pricingVersion              String
  pricingJson                 Json
  status                      String   @default("disabled")
  isDefault                   Boolean  @default(false)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([capability, status])
}

/// 分镜级视觉策略覆盖。唯一约束为 (storyboardRecordId, segmentId)；
/// projectId 只用于 owner scope/index。
model StoryboardSegmentOverride {
  id                   String   @id @default(uuid())
  projectId            String
  storyboardRecordId   String
  segmentId            String
  strategyOverride     String?
  revision             Int      @default(1)
  updatedByUserId      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  project              Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  storyboardRecord     StoryboardRecord   @relation(fields: [storyboardRecordId], references: [id], onDelete: Cascade)

  @@unique([storyboardRecordId, segmentId])
  @@index([projectId])
}

/// 生成成本报价。quote 创建时计算并持久化 quoteFingerprint，提交时重算比对。
model GenerationCostQuote {
  id                        String    @id @default(uuid())
  projectId                 String
  userId                    String?
  operation                 String
  configurationHash         String
  quoteFingerprint          String
  pricingHash               String
  pricingVersionSetJson     Json
  itemsJson                 Json
  estimatedCostMicros       String
  authorizationCostMicros   String
  containsUnboundedItem     Boolean   @default(false)
  budgetLimitMicros         String?
  overBudget                Boolean   @default(false)
  expiresAt                 DateTime
  consumedAt                DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  project                   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generationRuns            GenerationRun[]
  snapshots                 RunConfigurationSnapshot[]

  @@index([projectId, operation])
}

/// 不可变运行配置快照。repository 不提供 update；重新运行创建新快照。
model RunConfigurationSnapshot {
  id                            String   @id @default(uuid())
  projectId                     String
  userId                        String?
  stage                         String
  operation                     String
  runId                         String?
  projectConfigurationRevision  Int
  schemaVersion                 String
  configurationHash             String
  resolvedConfigurationJson     Json
  resolutionTraceJson           Json
  quoteId                       String?
  quoteFingerprint              String?
  estimatedCostMicros           String?
  authorizationCostMicros       String?
  containsUnboundedItem         Boolean  @default(false)
  budgetLimitMicros             String?
  budgetOverrideAuthorized      Boolean  @default(false)
  pricingHash                   String?
  pricingVersionSetJson         Json
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  project                       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quote                         GenerationCostQuote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  generationRuns                GenerationRun[]
  usageCostRecords              UsageCostRecord[]

  @@index([projectId])
}

/// 生成运行记录。用户提交、quote 消费、snapshot 和可恢复执行之间的持久化桥梁。
model GenerationRun {
  id                            String    @id @default(uuid())
  projectId                     String
  userId                        String?
  operation                     String
  idempotencyKey                String
  payloadFingerprint            String
  quoteId                       String?   @unique
  runConfigurationSnapshotId    String    @unique
  dispatchPayloadJson           Json
  status                        String
  dispatchLeaseOwner            String?
  dispatchLeaseExpiresAt        DateTime?
  dispatchClaimCount            Int       @default(0)
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt
  project                       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshot                      RunConfigurationSnapshot @relation(fields: [runConfigurationSnapshotId], references: [id], onDelete: Restrict)
  quote                         GenerationCostQuote? @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  events                        GenerationRunEvent[]
  providerJobs                  AssetProviderJobRecord[]

  @@unique([projectId, operation, idempotencyKey])
  @@index([projectId, status])
}

/// 运行事件（append-only）。自动降级、用户接受 fallback、实际路线变化写事件。
model GenerationRunEvent {
  id               String   @id @default(uuid())
  generationRunId  String
  eventType        String
  segmentId        String?
  eventJson        Json
  createdAt        DateTime @default(now())
  generationRun    GenerationRun @relation(fields: [generationRunId], references: [id], onDelete: Cascade)

  @@index([generationRunId])
}

/// 统一计量与成本视图。不替代 interaction log 或 provider job。
/// 唯一约束防止重复回放同一 provider attempt 产生重复费用。
model UsageCostRecord {
  id                            String   @id @default(uuid())
  runConfigurationSnapshotId    String
  assetProviderJobRecordId      String?
  interactionId                 String?
  capability                    String
  providerKey                   String
  modelId                       String
  providerRequestKey            String
  attemptIndex                  Int
  status                        String
  unitType                      String
  inputUnits                    Int?
  outputUnits                   Int?
  estimatedCostMicros           String
  actualCostMicros              String?
  costBasis                     String
  durationMs                    Int?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  snapshot                      RunConfigurationSnapshot @relation(fields: [runConfigurationSnapshotId], references: [id], onDelete: Cascade)
  assetProviderJobRecord        AssetProviderJobRecord? @relation(fields: [assetProviderJobRecordId], references: [id], onDelete: SetNull)

  @@unique([runConfigurationSnapshotId, providerRequestKey, attemptIndex])
  @@index([runConfigurationSnapshotId])
}
